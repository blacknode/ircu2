#: modules/commands/m_bot/m_bot.c:323
msgid "Service"
msgstr "Servicio"

#: modules/commands/m_bot/m_bot.c:324
msgid "Bot"
msgstr "Bot"

#: modules/commands/m_bot/m_bot.c:327
msgid "the server"
msgstr "el servidor"

#: modules/commands/m_bot/m_bot.c:334
#, no-c-format
