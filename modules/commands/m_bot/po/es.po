#: modules/commands/m_bot/m_bot.c:89
#, no-c-format
msgid "%C :%s is not a bot of this server"
msgstr "%C :%s no es un bot de este servidor"

#: modules/commands/m_bot/m_bot.c:112
#, no-c-format
msgid "%C :%s is a service of the network and cannot be %s; it belongs to %s"
msgstr "%C :%s es un servicio de la red y no se puede %s; pertenece a %s"

#: modules/commands/m_bot/m_bot.c:136
#, no-c-format
msgid "%C :Cannot create bot %s: no numeric nick is free"
msgstr "%C :No se puede crear el bot %s: no queda ningún numeric libre"

#: modules/commands/m_bot/m_bot.c:148
#, no-c-format
msgid "%C :Bot %s (%s@%s) created"
msgstr "%C :Bot %s (%s@%s) creado"

#: modules/commands/m_bot/m_bot.c:153 modules/commands/m_bot/m_bot.c:242
#, no-c-format
msgid "%C :Bot %s joined %s"
msgstr "%C :El bot %s ha entrado en %s"

#: modules/commands/m_bot/m_bot.c:181
#, no-c-format
msgid "%C :Bot %s destroyed"
msgstr "%C :Bot %s destruido"

#: modules/commands/m_bot/m_bot.c:203
#, no-c-format
msgid "%C :Bot %s already has that nick"
msgstr "%C :El bot %s ya tiene ese nick"

#: modules/commands/m_bot/m_bot.c:219
#, no-c-format
msgid "%C :Bot %s renamed to %s"
msgstr "%C :Bot %s renombrado a %s"

#: modules/commands/m_bot/m_bot.c:266
#, no-c-format
