#: modules/services/irc_services/dispatch.c:171
#, no-c-format
msgid "Unknown command %s.  Type HELP for a list of commands."
msgstr "Comando desconocido: %s.  Escribe HELP para ver la lista de comandos."

#: modules/services/irc_services/dispatch.c:181
#, no-c-format
msgid "Permission denied: %s is for IRC operators."
msgstr "Permiso denegado: %s es sólo para operadores de IRC."

#: modules/services/irc_services/dispatch.c:188
#, no-c-format
msgid "Not enough parameters.  Syntax: %s"
msgstr "Faltan parámetros.  Sintaxis: %s"

#: modules/services/irc_services/svc_chanserv.c:52
#, no-c-format
msgid "Which channel?  Syntax: %s"
msgstr "¿Qué canal?  Sintaxis: %s"

#: modules/services/irc_services/svc_chanserv.c:63
#, no-c-format
msgid "Channel %s does not exist."
msgstr "El canal %s no existe."

#: modules/services/irc_services/svc_chanserv.c:79
#, no-c-format
msgid "%s has %u user and was created %s."
msgid_plural "%s has %u users and was created %s."
msgstr[0] "%s tiene %u usuario y se creó el %s."
msgstr[1] "%s tiene %u usuarios y se creó el %s."

#: modules/services/irc_services/svc_chanserv.c:84
#, no-c-format
msgid "Topic: %s (set by %s)"
msgstr "Tema: %s (puesto por %s)"

#: modules/services/irc_services/svc_chanserv.c:88
msgid "INFO <#channel>"
msgstr "INFO <#canal>"

#: modules/services/irc_services/svc_chanserv.c:89
msgid "Show what the network knows about a channel."
msgstr "Muestra lo que la red sabe de un canal."

#: modules/services/irc_services/svc_chanserv.c:95
msgid "Channel services"
msgstr "Servicios de canales"

#: modules/services/irc_services/svc_common.c:53
#, no-c-format
msgid "No help for %s."
msgstr "No hay ayuda para %s."

#: modules/services/irc_services/svc_common.c:57
#, no-c-format
msgid "Syntax: %s"
msgstr "Sintaxis: %s"

#: modules/services/irc_services/svc_common.c:60
#, no-c-format
msgid "May also be used as %c%s on a channel %s is on."
msgstr "También se puede usar como %c%s en un canal donde esté %s."

#: modules/services/irc_services/svc_common.c:67
msgid "Commands:"
msgstr "Comandos:"

#: modules/services/irc_services/svc_common.c:70
msgid "Type HELP <command> for the syntax of a command."
msgstr "Escribe HELP <comando> para ver la sintaxis de un comando."

#: modules/services/irc_services/svc_common.c:76
#, no-c-format
msgid "%s is irc services %s on %s (%s)"
msgstr "%s son los servicios de IRC %s en %s (%s)"

#: modules/services/irc_services/svc_common.c:81
msgid "HELP [command]"
msgstr "HELP [comando]"

#: modules/services/irc_services/svc_common.c:81
msgid "List the commands, or explain one."
msgstr "Lista los comandos, o explica uno."

#: modules/services/irc_services/svc_common.c:83
msgid "Which services these are, and where they run."
msgstr "Qué servicios son estos y dónde funcionan."

#: modules/services/irc_services/svc_nickserv.c:43
#, no-c-format
msgid "%s is not online."
msgstr "%s no está conectado."

#: modules/services/irc_services/svc_nickserv.c:47
#, no-c-format
msgid "%s is %s@%s (%s), on %s."
msgstr "%s es %s@%s (%s), en %s."

#: modules/services/irc_services/svc_nickserv.c:51
#, no-c-format
msgid "%s is a registered user."
msgstr "%s es un usuario registrado."

#: modules/services/irc_services/svc_nickserv.c:53
#, no-c-format
msgid "%s is a service of the network."
msgstr "%s es un servicio de la red."

#: modules/services/irc_services/svc_nickserv.c:57
msgid "INFO <nick>"
msgstr "INFO <nick>"

#: modules/services/irc_services/svc_nickserv.c:57
msgid "Show what the network knows about a nick."
msgstr "Muestra lo que la red sabe de un nick."

#: modules/services/irc_services/svc_nickserv.c:64
msgid "Nickname services"
msgstr "Servicios de nicks"

#: modules/services/irc_services/nick_policy.c:210
#, no-c-format
msgid "This nickname is registered.  Identify with /msg %s IDENTIFY <address> <password> within %d seconds, or you will be renamed."
msgstr "Este nick está registrado.  Identifícate con /msg %s IDENTIFY <dirección> <contraseña> en %d segundos, o se te renombrará."

#: modules/services/irc_services/nick_policy.c:233
#, no-c-format
msgid "That nickname is not registered; you are free to use it."
msgstr "Ese nick no está registrado; puedes usarlo sin más."

#: modules/services/irc_services/nick_policy.c:330
#, no-c-format
msgid "Nickname services are not available, so this nickname could not be checked."
msgstr "Los servicios de nicks no están disponibles, así que no se ha podido comprobar este nick."

#: modules/services/irc_services/nick_policy.c:404
#, no-c-format
msgid "You did not identify in time; you are being renamed."
msgstr "No te has identificado a tiempo; se te está renombrando."

#: modules/services/irc_services/svc_nickserv.c:60
#, no-c-format
msgid "Identify with the service on your own server."
msgstr "Identifícate con el servicio de tu propio servidor."

#: modules/services/irc_services/svc_nickserv.c:67
#, no-c-format
msgid "Do not send a password to a channel.  Change it."
msgstr "No mandes una contraseña a un canal.  Cámbiala."

#: modules/services/irc_services/svc_nickserv.c:92
#, no-c-format
msgid "Another login is already under way."
msgstr "Ya hay otra identificación en curso."

#: modules/services/irc_services/svc_nickserv.c:96
#, no-c-format
msgid "You have already authenticated."
msgstr "Ya te has autenticado."

#: modules/services/irc_services/svc_nickserv.c:100
#, no-c-format
msgid "Too many failed attempts on this connection."
msgstr "Demasiados intentos fallidos en esta conexión."

#: modules/services/irc_services/svc_nickserv.c:104
#, no-c-format
msgid "This server will not take a password over an unencrypted connection."
msgstr "Este servidor no acepta contraseñas por una conexión sin cifrar."

#: modules/services/irc_services/svc_nickserv.c:108
#, no-c-format
msgid "Nickname services are not available right now."
msgstr "Los servicios de nicks no están disponibles ahora mismo."

#: modules/services/irc_services/svc_nickserv.c:119
#, no-c-format
msgid "You are identified as %s."
msgstr "Estás identificado como %s."

#: modules/services/irc_services/svc_nickserv.c:121
#, no-c-format
msgid "You are not identified."
msgstr "No estás identificado."

#: modules/services/irc_services/svc_nickserv.c:124
#, no-c-format
msgid "This nickname is registered and you have not proved it is yours, so you cannot do anything else until you identify or are renamed."
msgstr "Este nick está registrado y no has demostrado que sea tuyo, así que no puedes hacer nada más hasta que te identifiques o se te renombre."

#: modules/services/irc_services/svc_nickserv.c:131
msgid "IDENTIFY <address> <password> [<account>]"
msgstr "IDENTIFY <dirección> <contraseña> [<cuenta>]"

#: modules/services/irc_services/svc_nickserv.c:131
msgid "Prove an account is yours."
msgstr "Demuestra que una cuenta es tuya."

#: modules/services/irc_services/svc_nickserv.c:133
msgid "STATUS"
msgstr "STATUS"

#: modules/services/irc_services/svc_nickserv.c:133
msgid "Say whether you are identified."
msgstr "Dice si estás identificado."
