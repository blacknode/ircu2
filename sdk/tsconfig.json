{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    // No "DOM".  The SDK runs in a browser, in React Native, in a Wails
    // webview and under Bun, and the surest way to keep it portable is to
    // not have the browser's types in scope at all: a stray `window` or
    // `document` is then a compile error rather than a crash on a phone.
    // What it *does* assume exists is declared, exhaustively, in
    // packages/protocol/src/globals.d.ts -- which doubles as the list of
    // what a runtime has to provide.
    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts"]
}
